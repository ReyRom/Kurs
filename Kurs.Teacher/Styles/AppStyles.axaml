<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Button">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#4F46E5"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#F0F1FF"/>
    <Setter Property="Foreground" Value="#4F46E5"/>
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#626A7E"/>
  </Style>
  <Style Selector="Button.lesson">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="3"/>
  </Style>
  <Style Selector="Button.lesson:pointerover">
    <Setter Property="Background" Value="#F4F5FF"/>
  </Style>
  <Style Selector="Button.tree-discipline">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="#25293A"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="CornerRadius" Value="9"/>
  </Style>
  <Style Selector="Button.tree-lesson">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="#303548"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="9,7"/>
    <Setter Property="Margin" Value="10,0,0,2"/>
  </Style>
  <Style Selector="Button.tree-lesson:pointerover">
    <Setter Property="Background" Value="#F4F5FF"/>
  </Style>
  <Style Selector="Button.list-card">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="#25293A"/>
    <Setter Property="Background" Value="#FAFAFD"/>
    <Setter Property="Padding" Value="13"/>
    <Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <Style Selector="Button.add">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#4F46E5"/>
  </Style>
  <Style Selector="Button.export">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="#25264A"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#4F46E5"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="BorderBrush" Value="#DFE2EA"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="9,7"/>
  </Style>
  <Style Selector="TextBlock.emoji">
    <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
    <Setter Property="FontSize" Value="20"/>
  </Style>
  <Style Selector="TextBox.title-editor">
    <Setter Property="FontSize" Value="27"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E7E9F0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#4F46E5"/>
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#475569"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="Expander.editor-section">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander.editor-section /template/ ToggleButton#PART_Header">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#4A5064"/>
    <Setter Property="Padding" Value="4,7"/>
  </Style>
  <Style Selector="Window">
    <Setter Property="Foreground" Value="#1E293B"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="#1E293B"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="#B42318"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.test-item">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#1E293B"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Button.test-item:pointerover">
    <Setter Property="Background" Value="#F0F1FF"/>
  </Style>
  <Style Selector="Button.test-item.selected, Button.tree-lesson.selected">
    <Setter Property="Background" Value="#E8EAFE"/>
    <Setter Property="Foreground" Value="#3730A3"/>
    <Setter Property="BorderBrush" Value="#4F46E5"/>
    <Setter Property="BorderThickness" Value="3,0,0,0"/>
  </Style>
</Styles>


