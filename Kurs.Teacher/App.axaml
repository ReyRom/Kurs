<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kurs.Teacher.App"
             xmlns:local="using:Kurs.Teacher"
             xmlns:theme="using:Material.Styles.Themes"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <theme:MaterialTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Lime"/>
        <StyleInclude Source="avares://Kurs.Teacher/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
