<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kurs.Student.App"
             xmlns:local="using:Kurs.Student"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Kurs.Student/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
