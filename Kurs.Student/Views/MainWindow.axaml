<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kurs.Student.ViewModels"
        x:Class="Kurs.Student.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        x:Name="Root"
        Width="1360" Height="860" MinWidth="1050" MinHeight="680"
        Background="#F4F6FA"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kurs — обучение">
  <Grid RowDefinitions="68,*,38">
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="280,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="11" Background="#4255E8">
            <TextBlock Text="K" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="KURS" FontWeight="Bold" FontSize="14" LetterSpacing="1.5"/>
            <TextBlock Text="Учебное пространство" Foreground="#8A91A3" FontSize="10"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding CourseTitle}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CourseAuthor}" Foreground="#8990A1" FontSize="11"/>
        </StackPanel>

        <Button Grid.Column="2" Classes="primary" Command="{Binding OpenCourseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="＋" FontSize="16"/>
            <TextBlock Text="Открыть .kurs" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="308,*">
      <Border Background="#FFFFFF" BorderBrush="#E7EAF0" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Margin="18,20,18,12" Spacing="6">
            <Button Classes="nav" Classes.active="{Binding IsOverviewVisible}" Command="{Binding ShowOverviewCommand}">
              <Grid ColumnDefinitions="28,*"><TextBlock Classes="emoji" Text="🏡"/><TextBlock Grid.Column="1" Text="Обзор курса" VerticalAlignment="Center"/></Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsScheduleVisible}" Command="{Binding ShowScheduleCommand}">
              <Grid ColumnDefinitions="28,*"><TextBlock Classes="emoji" Text="📆"/><TextBlock Grid.Column="1" Text="Расписание" VerticalAlignment="Center"/></Grid>
            </Button>
          </StackPanel>

          <Border Grid.Row="1" Margin="18,4,18,16" Padding="15" CornerRadius="13" Background="#F3F5FF">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Прогресс курса" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}" Foreground="#4255E8" FontWeight="Bold" FontSize="12"/>
              </Grid>
              <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Foreground="#4255E8" Background="#DDE2FA"/>
              <TextBlock Text="{Binding ProgressText}" Foreground="#7B8499" FontSize="10"/>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,0,18,22" Spacing="14">
              <TextBlock Text="СОДЕРЖАНИЕ КУРСА" Foreground="#9299AA" FontSize="10" FontWeight="Bold" LetterSpacing="1.2"/>
              <ItemsControl ItemsSource="{Binding Disciplines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,14" Spacing="5">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,4" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8,3,0,6">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>                      <ItemsControl ItemsSource="{Binding Lessons}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="lesson" Command="{Binding $parent[Window].DataContext.SelectLessonCommand}" CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding StateIcon}" Foreground="#596AE9" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailabilityText}" Foreground="#969DAE" FontSize="9" Margin="0,3,0,0"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <!-- Обзор -->
        <ScrollViewer IsVisible="{Binding IsOverviewVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,34,40,50" Spacing="26" MaxWidth="1060" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,330" ColumnSpacing="26">
              <Border Classes="hero" MinHeight="250">
                <Grid RowDefinitions="Auto,*,Auto">
                  <Border Background="#178454" CornerRadius="20" Padding="10,5" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding NextLessonDateText}" Foreground="White" FontWeight="SemiBold" FontSize="10" LetterSpacing="1"/>
                  </Border>
                  <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="9">
                    <TextBlock Text="Продолжите обучение" Foreground="#DDE2FF" FontSize="13"/>
                    <TextBlock Text="{Binding NextLessonTitle}" Foreground="White" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NextLessonDiscipline}" Foreground="#DDE2FF" FontSize="12"/>
                  </StackPanel>
                  <Button Grid.Row="2" Classes="heroButton" Command="{Binding SelectLessonCommand}" CommandParameter="{Binding NextLesson}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="Продолжить занятие"/><TextBlock Text="→" FontSize="16"/></StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="22">
                <StackPanel Spacing="17">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Ближайшие занятия" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Classes="emoji" Text="📆" Foreground="#6D768D"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding UpcomingSchedule}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="42,*,Auto" Margin="0,2,0,12">
                          <Border Background="#F2F4FA" CornerRadius="9" Width="40" Height="44">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                              <TextBlock Text="{Binding Month}" HorizontalAlignment="Center" Foreground="#8D95A7" FontSize="8"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding LessonTitle}" Margin="11,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
                          <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#596AE9" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Ваш путь по курсу" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding ScheduleModeText}" Foreground="#A35A2A" Background="#FFF0E6" Padding="10,5" FontSize="10"/>
              </Grid>
              <TextBlock Text="{Binding CourseCompositionText}" Foreground="#7D8699" FontSize="11"/>
              <ItemsControl ItemsSource="{Binding CourseSections}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="statCard" Width="300" Margin="0,0,16,16">
                      <StackPanel Spacing="12"><TextBlock Text="{Binding Number}" Classes="stepNumber"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="#848C9F" FontSize="11"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Foreground="#596AE9"/></StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Расписание -->
        <ScrollViewer IsVisible="{Binding IsScheduleVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="44,34,44,60" Width="960" HorizontalAlignment="Center" Spacing="22">
            <StackPanel Spacing="6">
              <TextBlock Text="Расписание курса" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ScheduleModeText}" Foreground="#7C8599"/>
            </StackPanel>
            <Border Classes="card" Padding="20">
              <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel><TextBlock Text="Дисциплин" Classes="eyebrow"/><TextBlock Text="{Binding TotalDisciplines}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Занятий" Classes="eyebrow"/><TextBlock Text="{Binding TotalLessons}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Материалов" Classes="eyebrow"/><TextBlock Text="{Binding TotalMaterials}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Тестов" Classes="eyebrow"/><TextBlock Text="{Binding TotalTests}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </Border>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <TextBlock Text="НЕДЕЛЯ" Classes="eyebrow" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding ScheduleWeekTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                  <Button Grid.Column="2" Classes="secondary" Command="{Binding CurrentScheduleWeekCommand}" Content="Текущая неделя" Margin="0,0,8,0"/>
                  <Button Grid.Column="3" Classes="icon" Command="{Binding PreviousScheduleWeekCommand}" Content="‹" ToolTip.Tip="Предыдущая неделя"/>
                  <Button Grid.Column="4" Classes="icon" Command="{Binding NextScheduleWeekCommand}" Content="›" ToolTip.Tip="Следующая неделя"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ScheduleWeekDays}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="11" Margin="3" MinHeight="185" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                          <Border Background="{Binding HeaderBackground}" Padding="10,9">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DayName}" Foreground="{Binding HeaderForeground}" FontSize="9" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding DayNumber}" Foreground="{Binding HeaderForeground}" FontWeight="Bold"/></Grid>
                          </Border>
                          <Grid Grid.Row="1">
                            <TextBlock Text="Нет занятий" IsVisible="{Binding HasNoItems}" Foreground="#A0A7B5" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding Items}" Margin="6,8">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Classes="weekLesson" Command="{Binding $parent[Window].DataContext.SelectLessonCommand}" CommandParameter="{Binding Lesson}" IsEnabled="{Binding CanOpen}">
                                    <StackPanel Spacing="4"><TextBlock Text="{Binding Time}" Foreground="#4255E8" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding LessonTitle}" FontSize="10" TextWrapping="Wrap" MaxLines="3"/><TextBlock Text="{Binding StatusText}" Foreground="#9299AA" FontSize="8"/></StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="Все занятия" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding Schedule}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Padding="20" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="70,*,Auto" RowDefinitions="Auto,Auto">
                      <Border Grid.RowSpan="2" Background="#F2F4FA" CornerRadius="12" Width="56" Height="62" HorizontalAlignment="Left">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Day}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/><TextBlock Text="{Binding Month}" HorizontalAlignment="Center" Foreground="#8D95A7" FontSize="9"/></StackPanel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding LessonTitle}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding DisciplineTitle}" Foreground="#7C8599" FontSize="11"/></StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="5"><TextBlock Text="{Binding Time}" Foreground="#4255E8" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding StatusText}" Foreground="#8B93A5" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
                      <Button Grid.Row="1" Grid.Column="1" Classes="secondary" Command="{Binding $parent[Window].DataContext.SelectLessonCommand}" CommandParameter="{Binding Lesson}" IsEnabled="{Binding CanOpen}" Content="Открыть занятие" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Занятие -->
        <Grid IsVisible="{Binding IsLessonVisible}" RowDefinitions="Auto,*">
          <Border Background="White" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="34,18">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding SelectedDisciplineTitle}" Foreground="#596AE9" FontSize="10" FontWeight="Bold" LetterSpacing="0.8"/>
                <TextBlock Text="{Binding SelectedLessonTitle}" FontSize="22" FontWeight="SemiBold"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#E8F6EF" CornerRadius="9" Padding="11,6" VerticalAlignment="Center"><TextBlock Text="●  Доступно" Foreground="#27845B" FontSize="10"/></Border>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="230,*" Margin="26">
            <StackPanel Spacing="16" Margin="0,0,18,0">
              <TextBlock Text="МАТЕРИАЛЫ" Classes="eyebrow"/>
              <ItemsControl ItemsSource="{Binding CurrentMaterials}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="material" Command="{Binding $parent[Window].DataContext.SelectMaterialCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="26,*"><TextBlock Classes="emoji" Text="📖" Foreground="#596AE9"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/></Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="САМОПРОВЕРКА" Classes="eyebrow" Margin="0,12,0,0"/>
              <ItemsControl ItemsSource="{Binding CurrentTests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="material" Command="{Binding $parent[Window].DataContext.OpenTestCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,Auto"><TextBlock Text="✓" Foreground="#E17845"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastResultText}" Foreground="#9299AA" FontSize="9" Margin="0,3,0,0"/></Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Grid.Column="1" Classes="card" ClipToBounds="True">
              <Grid>
                <NativeWebView Source="{Binding MaterialSource}" IsVisible="{Binding HasMaterial}"/>
                <ScrollViewer IsVisible="{Binding HasNoMaterial}">
                  <StackPanel Margin="52" MaxWidth="720" Spacing="19">
                    <Border Width="52" Height="52" CornerRadius="16" Background="#EEF0FF" HorizontalAlignment="Left"><TextBlock Text="▤" Foreground="#4255E8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding SelectedLessonTitle}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedLessonDescription}" Foreground="#687187" FontSize="14" LineHeight="23" TextWrapping="Wrap"/>
                    <Border Background="#F6F7FB" CornerRadius="13" Padding="20" Margin="0,8,0,0">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Материал курса" FontWeight="SemiBold"/>
                        <TextBlock Text="После импорта файла .kurs здесь будет открыт подготовленный преподавателем HTML-материал с изображениями и видео. Интерфейс работает локально и не требует подключения к интернету." Foreground="#747D91" FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding CurrentTests}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#E2E5ED" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#8A92A5" FontSize="11"/><TextBlock Text="{Binding LastResultText}" Foreground="#596AE9" FontSize="11" FontWeight="SemiBold"/></StackPanel>
                              <Button Grid.Column="1" Classes="secondary" Command="{Binding $parent[Window].DataContext.OpenTestCommand}" CommandParameter="{Binding}" Content="Открыть тест →"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Страница перед запуском теста -->
        <ScrollViewer IsVisible="{Binding IsTestIntroVisible}">
          <StackPanel Margin="44,32,44,60" MaxWidth="760" HorizontalAlignment="Center" Spacing="22">
            <Button Classes="back" Command="{Binding BackToLessonCommand}" Content="←  Вернуться к занятию" HorizontalAlignment="Left"/>
            <Border Classes="card" Padding="38">
              <StackPanel Spacing="24">
                <Border Width="62" Height="62" CornerRadius="18" Background="#EEF0FF" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="#4255E8" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Spacing="8">
                  <TextBlock Text="САМОПРОВЕРКА" Classes="eyebrow"/>
                  <TextBlock Text="{Binding SelectedTest.Title}" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="Проверьте, насколько хорошо вы усвоили материал занятия. Ограничений по времени и количеству попыток нет." Foreground="#687187" FontSize="13" LineHeight="21" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <Border Background="#F6F7FB" CornerRadius="12" Padding="16"><StackPanel Spacing="5"><TextBlock Text="ВОПРОСОВ" Classes="eyebrow"/><TextBlock Text="{Binding SelectedTest.QuestionCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                  <Border Grid.Column="1" Background="#F6F7FB" CornerRadius="12" Padding="16"><StackPanel Spacing="5"><TextBlock Text="МАКСИМУМ" Classes="eyebrow"/><TextBlock Text="{Binding SelectedTest.TotalPoints, StringFormat={}{0} баллов}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                  <Border Grid.Column="2" Background="#F6F7FB" CornerRadius="12" Padding="16"><StackPanel Spacing="5"><TextBlock Text="ПОПЫТОК" Classes="eyebrow"/><TextBlock Text="Без ограничений" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                </Grid>
                <Border Background="#F1F3FF" CornerRadius="13" Padding="18">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="◷" Foreground="#4255E8" FontSize="19" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="4"><TextBlock Text="Последнее прохождение" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedTest.LastResultText}" Foreground="#596AE9"/><TextBlock Text="{Binding SelectedTest.LastResultDateText}" Foreground="#8A92A5" FontSize="10"/></StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="После завершения будет показано только количество набранных баллов. Новая попытка заменит предыдущий сохранённый результат." Foreground="#848C9F" FontSize="11" TextWrapping="Wrap"/>
                <Button Classes="primary large" Command="{Binding BeginTestCommand}" Content="Начать" HorizontalAlignment="Right"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Тест -->
        <ScrollViewer IsVisible="{Binding IsTestVisible}">
          <StackPanel Margin="44,32,44,60" MaxWidth="820" HorizontalAlignment="Center" Spacing="22">
            <Button Classes="back" Command="{Binding BackToLessonCommand}" Content="←  Вернуться к занятию" HorizontalAlignment="Left"/>
            <StackPanel Spacing="6"><TextBlock Text="{Binding SelectedTest.Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedTest.Subtitle}" Foreground="#7C8599"/></StackPanel>
            <ItemsControl ItemsSource="{Binding SelectedTest.Questions}" IsVisible="{Binding SelectedTest.IsNotFinished}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Padding="24" Margin="0,0,0,14">
                    <StackPanel Spacing="16">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TypeLabel}" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="{Binding Points, StringFormat={}{0} балл(а)}" Foreground="#8C94A5" FontSize="10"/></Grid>
                      <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding Answers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="answer" Command="{Binding SelectCommand}">
                              <Grid ColumnDefinitions="22,*"><CheckBox IsChecked="{Binding IsSelected}" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="{Binding Text}" Margin="8,0" TextWrapping="Wrap"/></Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="primary large" Command="{Binding FinishTestCommand}" Content="Завершить тест" HorizontalAlignment="Right" IsVisible="{Binding SelectedTest.IsNotFinished}"/>

            <Border Classes="result" IsVisible="{Binding SelectedTest.IsFinished}">
              <StackPanel Spacing="15" HorizontalAlignment="Center">
                <Border Width="66" Height="66" CornerRadius="33" Background="#FFFFFF24"><TextBlock Text="✓" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Тест завершён" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedTest.Score, StringFormat=Набрано {0} баллов}" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="Результат сохранён локально. Вы можете пройти тест повторно." Foreground="#DCE2FF" FontSize="11"/>
                <Button Classes="heroButton" Command="{Binding OpenTestCommand}" CommandParameter="{Binding SelectedTest}" Content="Вернуться к тесту" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E7EAF0" BorderThickness="0,1,0,0" Padding="24,0">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock Text="●" Foreground="#32A273" FontSize="9"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#737C90" FontSize="10" Margin="8,0"/>
        <TextBlock Grid.Column="2" Text="Все данные хранятся локально" Foreground="#9AA1B0" FontSize="9"/>
      </Grid>
    </Border>
  </Grid>
</Window>

