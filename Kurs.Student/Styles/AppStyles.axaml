<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="13,9"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#4255E8"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="#3346D5"/>
  </Style>
  <Style Selector="Button.primary.large">
    <Setter Property="Padding" Value="22,12"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#EEF0FF"/>
    <Setter Property="Foreground" Value="#4255E8"/>
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#626B7F"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="#F5F6FA"/>
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="#EEF0FF"/>
    <Setter Property="Foreground" Value="#3448DA"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.lesson">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#515A6D"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,7"/>
  </Style>
  <Style Selector="Button.lesson:pointerover">
    <Setter Property="Background" Value="#F5F6FA"/>
  </Style>
  <Style Selector="Button.material">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#566075"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="10"/>
  </Style>
  <Style Selector="Button.material:pointerover">
    <Setter Property="Background" Value="#EEF0FF"/>
    <Setter Property="Foreground" Value="#3448DA"/>
  </Style>
  <Style Selector="Button.heroButton">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#3144D3"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style Selector="Button.back">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#596AE9"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.answer">
    <Setter Property="Background" Value="#F8F9FB"/>
    <Setter Property="Foreground" Value="#4F586B"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Button.answer:pointerover">
    <Setter Property="Background" Value="#F0F2FF"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="#F3F5FA"/>
    <Setter Property="Foreground" Value="#596AE9"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinWidth" Value="34"/>
  </Style>
  <Style Selector="Button.weekLesson">
    <Setter Property="Background" Value="#F6F7FC"/>
    <Setter Property="Foreground" Value="#4F586B"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style Selector="Button.weekLesson:pointerover">
    <Setter Property="Background" Value="#EEF0FF"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="White"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="BorderBrush" Value="#E4E7EE"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="#4A5DE5"/>
    <Setter Property="CornerRadius" Value="19"/>
    <Setter Property="Padding" Value="28"/>
  </Style>
  <Style Selector="Border.statCard">
    <Setter Property="Background" Value="White"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BorderBrush" Value="#E4E7EE"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="20"/>
  </Style>
  <Style Selector="Border.result">
    <Setter Property="Background" Value="#4A5DE5"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="40"/>
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="#9299AA"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>
  <Style Selector="TextBlock.stepNumber">
    <Setter Property="Foreground" Value="#9AA1B2"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="#E9EBF1"/>
  </Style>
  <Style Selector="TextBlock.emoji">
    <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
    <Setter Property="FontSize" Value="18"/>
  </Style>
</Styles>
